# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# NEVER commit `.env` — it is listed in .gitignore.

# Backend selection: "ollama" (local model) or "groq" (cloud API)
LLM_BACKEND=ollama

# ── Local Ollama ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=ollama

# ── Cloud Groq (optional) ──
# Free key: https://console.groq.com/keys
# Multiple keys may be supplied comma-separated for automatic rotation.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b

# ── Reproducibility ──
# The --seed / --temperature CLI flags override these per run.
PID_SEED=0
PID_TEMPERATURE=0.1
